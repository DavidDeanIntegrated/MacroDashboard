# Copy this to .env.local and fill in your API keys
# NEVER commit .env.local to git

# FRED (Federal Reserve Economic Data)
FRED_API_KEY=your_fred_api_key_here

# Alpaca (market data fallback only; use a PAPER-account key — no trading/account calls are made)
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_API_SECRET=your_alpaca_api_secret_here

# Finnhub
FINNHUB_API_KEY=your_finnhub_api_key_here

# SEC EDGAR (no key needed, just a user agent)
EDGAR_USER_AGENT=YourName macro-dashboard your@email.com

# Historical prices and financials
POLYGON_API_KEY=your_polygon_api_key_here

